<?xml version="1.0" encoding="utf-8"?>
<!--
  The feed set, asserted by the repository rather than inherited from the machine.

  Without <clear/>, restore uses whatever sources the user's or the machine's NuGet.Config
  happens to list, and any of them can answer for any package id. GitHub-hosted runners
  carry a machine config naming nuget.org only, so this changes nothing there today — it is
  for every build that is not one, where an extra feed is how a package id comes to mean
  something else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
