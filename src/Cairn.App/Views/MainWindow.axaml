<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cairn.App.ViewModels"
        xmlns:core="using:Cairn.Core"
        xmlns:l="using:Cairn.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Cairn.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1000" Height="640"
        MinWidth="820" MinHeight="520"
        Icon="/Assets/cairn.ico"
        Title="Cairn">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Bottom" Padding="12,6"
                Classes="panel" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Width="110" IsIndeterminate="True"
                             IsVisible="{Binding Detail.IsWorking, FallbackValue=False}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Pack list -->
        <Border DockPanel.Dock="Left" Width="250" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource VsBorderBrush}"
                ClipToBounds="True"
                IsEnabled="{Binding NotProvisioning}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="8">
                    <!-- A horizontal StackPanel lays these out at their desired width and
                         lets them spill past the 250px sidebar into the detail pane. The
                         grid makes each button share the column instead. -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="6" RowSpacing="6">
                        <!-- Buttons size to their content by default, which leaves the
                             two columns visibly ragged. -->
                        <Grid.Styles>
                            <Style Selector="Button">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </Grid.Styles>
                        <Button Grid.Row="0" Grid.Column="0" Content="{l:Tr sidebar-new-pack}"
                                Command="{Binding BeginCreateCommand}" />
                        <Button Grid.Row="0" Grid.Column="1" Content="{l:Tr sidebar-import}"
                                Command="{Binding BeginImportCommand}" />
                        <!-- Application-level, so it is separated from the pack actions
                             above rather than sitting among them. -->
                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                Content="{l:Tr sidebar-preferences}"
                                Command="{Binding ShowPreferencesCommand}" />
                    </Grid>
                </StackPanel>

                <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackListItemViewModel">
                            <StackPanel Spacing="2" Margin="0,4">
                                <!-- The dot sits beside the name rather than under it, so
                                     a glance down the list finds the pack with the game
                                     without reading any of the rows. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{Binding Display}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource VsAccentHoverBrush}"
                                             IsVisible="{Binding IsPlaying}" />
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding ServerLine}" FontSize="11" Opacity="0.55"
                                           IsVisible="{Binding HasServer}" />
                                <TextBlock Text="{Binding PlayingLine}" FontSize="11"
                                           Foreground="{DynamicResource VsAccentHoverBrush}"
                                           IsVisible="{Binding IsPlaying}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Panel>

            <!-- Downloading a game version and/or runtime. Deliberately the only thing on
                 screen: a half-usable pack pane invites edits the running install cannot
                 see. -->
            <StackPanel IsVisible="{Binding ShowProvisioning}" Margin="40"
                        VerticalAlignment="Center" Spacing="16" MaxWidth="520">
                <TextBlock Text="{l:Tr provision-heading}" Classes="heading" FontSize="22"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProvisionStatus}" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <ProgressBar x:Name="ProvisionProgress"
                             Maximum="1" Value="{Binding ProvisionFraction}" Height="10"
                             IsIndeterminate="{Binding ProvisionIndeterminate}" />
                <TextBlock FontSize="11" Opacity="0.6" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="{l:Tr provision-explain}" />
                <Button Content="{l:Tr common-cancel}" HorizontalAlignment="Center"
                        Command="{Binding CancelProvisionCommand}" />
            </StackPanel>

            <!-- Import a shared pack -->
            <DockPanel IsVisible="{Binding ShowImport}" LastChildFill="True" Margin="20">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="{l:Tr quickimport-heading}" Classes="heading" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{l:Tr quickimport-explain}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{l:Tr quickimport-import-as}" VerticalAlignment="Center"
                                   FontSize="12" Opacity="0.7" />
                        <TextBox Grid.Column="1" Text="{Binding ImportAsId}"
                                 PlaceholderText="{l:Tr quickimport-keep-name}" />
                    </Grid>

                    <Border IsVisible="{Binding HasImportError}" Padding="10,8" CornerRadius="1"
                            Background="{DynamicResource VsErrorFillBrush}" BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding ImportError}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Tr quickimport-import}" Classes="accent" Padding="18,6"
                                Command="{Binding ImportPackCommand}" />
                        <Button Content="{l:Tr quickimport-cancel}" Padding="14,6"
                                Command="{Binding CancelImportCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBox Text="{Binding ImportText}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="monospace" FontSize="12"
                         PlaceholderText="{l:Tr quickimport-placeholder}" />
            </DockPanel>

            <!-- Nothing selected -->
            <TextBlock IsVisible="{Binding ShowEmpty}"
                       Text="{l:Tr empty-no-pack}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />

            <!-- New pack form -->
            <StackPanel IsVisible="{Binding ShowCreate}" Margin="24" Spacing="12" MaxWidth="440"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{l:Tr newpack-heading}" Classes="heading" FontSize="22" FontWeight="SemiBold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr newpack-name}" FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding NewPackName}" PlaceholderText="{l:Tr newpack-name-placeholder}" />
                    <!-- Shown, not asked for: the id is a folder name and travels in
                         shared bundles, but nobody should have to invent one. -->
                    <TextBlock FontSize="11" Opacity="0.55"
                               IsVisible="{Binding HasNewPackSlug}"
                               Text="{Binding NewPackSlug, StringFormat='Saved as {0}'}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr newpack-game-version}" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding GameVersionChoices}"
                              SelectedItem="{Binding NewPackGameVersion}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="{l:Tr newpack-version-placeholder}" />
                    <TextBlock Text="{l:Tr newpack-loading-versions}" FontSize="11" Opacity="0.55"
                               IsVisible="{Binding LoadingVersions}" />
                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="{l:Tr newpack-download-note}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr newpack-connect}"
                               FontSize="12" Opacity="0.7" />
                    <TextBox Text="{Binding NewPackConnect}" PlaceholderText="{l:Tr newpack-connect-placeholder}" />
                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="{l:Tr newpack-connect-note}" />
                </StackPanel>

                <Border IsVisible="{Binding HasNewPackError}" Padding="10,8" CornerRadius="1"
                        Background="{DynamicResource VsErrorFillBrush}" BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding NewPackError}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr newpack-create}" Command="{Binding CreatePackCommand}"
                            Classes="accent" Padding="18,6" />
                    <Button Content="{l:Tr newpack-cancel}" Command="{Binding CancelCreateCommand}" Padding="14,6" />
                </StackPanel>
            </StackPanel>

            <!-- Pack detail -->
            <DockPanel IsVisible="{Binding ShowDetail}" LastChildFill="True" Margin="16">

                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="{Binding Detail.Title}" Classes="heading" FontSize="22" FontWeight="SemiBold" />

                    <!-- Under the name and above everything else, because on an imported
                         pack it is the author's account of what this is — and it should not
                         take opening Settings to read it. Capped in width so a long one
                         stays a line or two rather than a wall. -->
                    <TextBlock Text="{Binding Detail.Description}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                               IsVisible="{Binding Detail.HasDescription, FallbackValue=False}" />

                    <TextBlock Text="{Binding Detail.Subtitle}" Opacity="0.7" FontSize="12" />
                    <TextBlock Text="{Binding Detail.ServerLine}" Opacity="0.7" FontSize="12"
                               IsVisible="{Binding Detail.HasServer, FallbackValue=False}" />

                    <!-- The published URL belongs here beside the server line, not on the
                         button: it is persistent state about the pack and the thing people
                         copy repeatedly, which leaves the button free to be an action. -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding Detail.HasShareUrl, FallbackValue=False}">
                        <TextBlock Text="{Binding Detail.ShareUrlLine}" Opacity="0.7" FontSize="12"
                                   VerticalAlignment="Center" />

                        <!-- Unlisted and public look identical from outside, and which one
                             this is decides whether passing the link on is sharing it or
                             publishing it. -->
                        <Border IsVisible="{Binding Detail.IsUnlisted, FallbackValue=False}"
                                VerticalAlignment="Center" Padding="5,1" CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource VsBorderBrush}"
                                Background="{DynamicResource VsSunkenBrush}">
                            <TextBlock Text="{l:Tr pack-unlisted}" FontSize="10" Opacity="0.75" />
                        </Border>

                        <Button Content="{l:Tr pack-open-link}" Padding="8,1" FontSize="11"
                                Command="{Binding Detail.OpenSharePageCommand}" />
                    </StackPanel>

                    <!-- Where the URL line would be. The address still answers, with a
                         tombstone, so saying nothing would leave the pack looking as if it
                         had never been shared at all. -->
                    <TextBlock Text="{Binding Detail.WithdrawnLine}" Opacity="0.7" FontSize="12"
                               IsVisible="{Binding Detail.IsWithdrawn, FallbackValue=False}"
                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding Detail.FollowingLine}" Opacity="0.7" FontSize="12"
                               IsVisible="{Binding Detail.IsFollowing, FallbackValue=False}" />

                    <!--
                        With the pack's own heading rather than in the Settings tab: an
                        author publishing again is news about this pack, and news nobody
                        opens a tab to look for. The button says what it does and stops
                        there — nothing is merged until the dialog has been read.
                    -->
                    <!-- The button lives beside Play; this is only the news. -->
                    <TextBlock Text="{Binding Detail.PackUpdateLine}" FontSize="12"
                               IsVisible="{Binding Detail.HasPackUpdate, FallbackValue=False}"
                               Foreground="{DynamicResource VsAccentBrush}" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="10,8" CornerRadius="1"
                        IsVisible="{Binding Detail.HasError, FallbackValue=False}"
                        Background="{DynamicResource VsErrorFillBrush}" BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Detail.Error}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,14,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Play is the only way in. It syncs first, so a separate sync
                             button was an action defined by what it did not do. -->
                        <Button Grid.Column="0"
                                Content="{Binding Detail.PlayLabel}" Command="{Binding Detail.PlayCommand}"
                                IsVisible="{Binding Detail.ShowPlay, FallbackValue=True}"
                                Classes="accent" Padding="22,6" FontWeight="SemiBold" MinWidth="96"
                                HorizontalAlignment="Left" />

                        <!-- Play's own slot, once the game is up: there is nothing to press
                             until it goes away, and this is what makes it go away. A hung
                             game leaves the pack unplayable and its save held open, and the
                             alternative is Activity Monitor. -->
                        <Button Grid.Column="0"
                                Content="{l:Tr pack-force-quit}" Command="{Binding Detail.ForceQuitCommand}"
                                IsVisible="{Binding Detail.CanForceQuit, FallbackValue=False}"
                                Classes="accent" Padding="22,6" FontWeight="SemiBold" MinWidth="96"
                                HorizontalAlignment="Left" />

                        <!-- Opposite Play so it is findable — a sharing site nobody
                             notices they can publish to has no packs on it — but not
                             accented, because Play is what the app was opened for and
                             Share is roughly once per pack. -->
                        <Button Grid.Column="2" Padding="16,6" MinWidth="96"
                                Content="{Binding Detail.ShareLabel}"
                                Command="{Binding Detail.PublishPackCommand}"
                                IsVisible="{Binding Detail.ShareOffered, FallbackValue=False}"
                                Classes.accent="{Binding Detail.ShareIsUrgent, FallbackValue=False}" />

                        <!--
                            The same slot for a pack that is somebody else's. Share pushes
                            your pack out; this pulls their pack in — one relationship with
                            cairns.gg, read from whichever end you are standing at. It is
                            also the only "check for updates" a follower sees, because the
                            mod-version controls are the author's until they are unlocked.
                        -->
                        <Button Grid.Column="2" Padding="16,6" MinWidth="96"
                                Content="{Binding Detail.ReviewUpstreamLabel}"
                                Command="{Binding Detail.ApplyPackUpdateCommand}"
                                IsVisible="{Binding Detail.CanReviewUpstream, FallbackValue=False}"
                                Classes.accent="{Binding Detail.HasPackUpdate, FallbackValue=False}" />
                    </Grid>

                    <!-- Syncing and process start take seconds; say what is happening. -->
                    <Border IsVisible="{Binding Detail.IsShowingLaunchStage, FallbackValue=False}"
                            Classes="sunken" Padding="10,7">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <!-- Only while it is still getting there. A bar that never
                                 fills for the hours somebody is playing is a launcher that
                                 looks stuck. -->
                            <ProgressBar Grid.Column="0" Width="90" Height="6" IsIndeterminate="True"
                                         IsVisible="{Binding Detail.IsStarting, FallbackValue=False}"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Detail.LaunchStage}"
                                       FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--
                    Bound to the pane rather than left to itself, so selecting another pack
                    opens on Mods. The pane is rebuilt per pack and its SelectedTab starts
                    at 0, so the reset falls out of that; a TabControl left alone keeps
                    whichever tab the last pack was on, which is how you end up looking at
                    one pack's Log believing it is another's.
                -->
                <TabControl Margin="0,14,0,0"
                            SelectedIndex="{Binding Detail.SelectedTab, Mode=TwoWay, FallbackValue=0}">

                    <!--
                        One list for both the pack and the results you build it from.
                        They used to be separate tabs, which made them look like peers
                        and hid each from the other: adding a mod gave no sign of where
                        it went, and the pack was invisible while searching.
                    -->
                    <TabItem Header="{l:Tr tab-mods}">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">

            <!--
                                Buttons that come and go live in a StackPanel, not in
                                columns of their own. A collapsed column still costs its
                                ColumnSpacing, so the visible button sat inset from the
                                search box above it and the list below by the width of the
                                gaps reserved for buttons that were not there.
                            -->
                            <!--
                                A locked copy of somebody else's pack shows the mods and
                                nothing that changes them. Not a rule — Core allows the edit
                                and the CLI still does it — only a statement about which of
                                two things is the default when the pack is a curation.
                            -->
                            <Border DockPanel.Dock="Top" Classes="sunken" Padding="10,7"
                                    Margin="0,0,0,8"
                                    IsVisible="{Binding Detail.IsLocked, FallbackValue=False}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding Detail.LockedNote}"
                                               FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{l:Tr pack-unlock}" Padding="12,3"
                                            FontSize="11"
                                            Command="{Binding Detail.UnlockModsCommand}" />
                                </Grid>
                            </Border>

                            <!--
                                Once unlocked, the way back depends on whether there is
                                anything to undo. Lock again is honest only while the copy
                                still matches the author's; after that the way back is a
                                reset, which says what it removes and what it costs a world.
                            -->
                            <Border DockPanel.Dock="Top" Classes="sunken" Padding="10,7"
                                    Margin="0,0,0,8"
                                    IsVisible="{Binding Detail.ShowUnlockedNote, FallbackValue=False}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding Detail.UnlockedNote}"
                                               FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{l:Tr pack-lock-again}" Padding="12,3"
                                            FontSize="11"
                                            IsVisible="{Binding Detail.CanRelock}"
                                            Command="{Binding Detail.LockModsCommand}" />
                                </Grid>
                            </Border>

                            <!--
                                One box for both kinds of looking, and no control to say
                                which. Typing narrows the pack as you type — free and
                                instant, since the answer is already in memory — and Search
                                sends the same words to ModDB for what the pack has not got.
                                Two boxes stacked said the same thing twice and still left
                                you reading placeholders to find out which one you wanted; a
                                selector in front of one box would be a mode, and a mode is
                                something to be in the wrong one of.
                            -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" x:Name="ModSearchBox"
                                         Text="{Binding Detail.SearchText}"
                                         PlaceholderText="{Binding Detail.SearchPlaceholder}"
                                         Margin="0,0,6,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <!-- Always the default button, not only before the first
                                         search. It used to stop being one as soon as results
                                         appeared, so typing a second search and pressing
                                         enter did nothing at all — the one moment the key is
                                         most obviously meant to search again.

                                         Gone on a pack that is somebody else's, which is
                                         what leaves the box a plain filter there: nothing on
                                         a locked pack may add a mod, so offering to go and
                                         find one would be offering a dead end. -->
                                    <Button Content="{l:Tr mods-search}"
                                            IsVisible="{Binding Detail.CanEditMods}"
                                            Command="{Binding Detail.SearchCommand}"
                                            IsDefault="True" />
                                    <!-- One button for both, because emptying the box is
                                         what undoes either. -->
                                    <Button Content="{l:Tr mods-search-clear}"
                                            IsVisible="{Binding Detail.CanClearSearch, FallbackValue=False}"
                                            Command="{Binding Detail.ClearSearchCommand}" />
                                </StackPanel>
                            </Grid>

                            <Grid DockPanel.Dock="Top" Margin="0,10,0,6"
                                  ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Detail.ListHeading}"
                                           FontSize="12" Opacity="0.7" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="{Binding Detail.UpdateSummary}"
                                           IsVisible="{Binding Detail.HasUpdateSummary}"
                                           Margin="8,0,8,0"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource VsParchmentBrush}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <!-- Nothing moves on its own, so checking is a thing you do.
                                         "mod" is in the label because a followed pack also has a
                                         Check for updates beside Play, and that one is the whole
                                         pack from its author — the two pull opposite ways. -->
                                    <Button Content="{l:Tr mods-check-updates}"
                                            IsVisible="{Binding Detail.ShowModUpdateCheck}"
                                            Command="{Binding Detail.CheckUpdatesCommand}"
                                            Padding="10,3" FontSize="11" />

                                    <!-- Ticked by the check that found them, because six
                                         updates scattered through a hundred and fifty rows
                                         are six rows nobody can see at once. Here rather
                                         than done invisibly, so it can be unticked — and it
                                         unticks itself when the last update is taken. -->
                                    <CheckBox x:Name="OnlyUpdates"
                                              Content="{l:Tr mods-only-updates}"
                                              IsChecked="{Binding Detail.OnlyUpdates}"
                                              IsVisible="{Binding Detail.ShowOnlyUpdates, FallbackValue=False}"
                                              VerticalAlignment="Center" FontSize="11" />
                                    <Button Content="{l:Tr mods-update-all}" Classes="accent"
                                            IsVisible="{Binding Detail.AnyUpdates}"
                                            Command="{Binding Detail.UpdateAllCommand}"
                                            Padding="10,3" FontSize="11" />
                                    <Button Content="{l:Tr mods-back}"
                                            IsVisible="{Binding Detail.ShowingSearch}"
                                            Command="{Binding Detail.ClearSearchCommand}"
                                            Padding="10,3" FontSize="11" />

                                    <!-- One request per unpinned mod, so this runs for
                                         seconds on a full pack. Without it the button
                                         looked broken and got pressed again. -->
                                    <TextBlock x:Name="CheckingUpdatesLine"
                                               VerticalAlignment="Center"
                                               FontSize="11" Opacity="0.6"
                                               IsVisible="{Binding Detail.CheckingUpdates, FallbackValue=False}"
                                               Text="{Binding Detail.CheckingUpdatesLine}" />
                                </StackPanel>
                            </Grid>

                            <!-- Both lists fill the same space; a DockPanel would
                                 dock the first one to the left at content width. -->
                            <Panel>
                                <!-- The pack -->
                                <!-- VisibleMods, not Mods: the filter narrows what is drawn
                                     and nothing else. See PackDetailViewModel.VisibleMods. -->
                                <ListBox x:Name="PackMods"
                                         IsVisible="{Binding !Detail.ShowingSearch}"
                                         ItemsSource="{Binding Detail.VisibleMods}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModRowViewModel">
                                        <Panel Margin="0,4" Background="Transparent"
                                               DoubleTapped="OnRowDoubleTapped">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                                  ColumnSpacing="8"
                                                  IsVisible="{Binding !ConfirmingRemove}">
                                                <!-- Same fixed well as the results, so the
                                                     two lists line up with each other. -->
                                                <Border Grid.Column="0" Width="32" Height="32"
                                                        Classes="sunken" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}"
                                                           IsVisible="{Binding HasIcon}"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <!-- Indented and dimmed: a dependency is here
                                                     because of the row above it, not because
                                                     the pack asked for it.

                                                     Wrapping, not stacking. A horizontal
                                                     StackPanel measures its children against
                                                     infinite width, so a long row did not
                                                     shrink or clip — it overflowed the
                                                     column, drew under the buttons to its
                                                     right, and lost whatever came last off
                                                     the edge of the window. Which was
                                                     silent: a mod named "Floral Zones:
                                                     Central Australian Region", required by
                                                     another mod and running unmarked, has
                                                     more to say than 500px of row, and the
                                                     note that mattered most was the one at
                                                     the end. This grows the row instead, and
                                                     only when it has to. -->
                                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Outside the wrap, so a second line
                                                         lands under the mod's name rather
                                                         than under the arrow pointing at
                                                         it. -->
                                                    <TextBlock Text="↳" FontSize="12" Opacity="0.5"
                                                               DockPanel.Dock="Left"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsDependency}" />
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <!-- Kept, quietly: the id is what the
                                                         manifest and lockfile record. -->
                                                    <TextBlock Text="{Binding ModId}" FontSize="11"
                                                               Margin="0,0,8,0"
                                                               Opacity="0.55" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding InstalledVersion}"
                                                               IsVisible="{Binding HasInstalledVersion}"
                                                               Margin="0,0,8,0"
                                                               FontSize="11" Opacity="0.75"
                                                               VerticalAlignment="Center" />
                                                    <!-- Both warnings before the caption that
                                                         merely repeats the row above, so the
                                                         line that wraps away is the one worth
                                                         least. -->
                                                    <TextBlock Text="{l:Tr mods-server-side}"
                                                               IsVisible="{Binding IsServerSide}"
                                                               Margin="0,0,8,0"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource VsWarningBrush}" />
                                                    <!-- Running on somebody's say-so rather
                                                         than on ModDB's word. Said here as
                                                         well as in the log, because the log
                                                         is not where anybody looks to see
                                                         what a pack is. -->
                                                    <TextBlock Text="{Binding UnmarkedNote}"
                                                               IsVisible="{Binding IsUnmarked}"
                                                               Margin="0,0,8,0"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource VsWarningBrush}" />
                                                    <TextBlock Text="{Binding RequiredByNote}"
                                                               IsVisible="{Binding IsDependency}"
                                                               FontSize="11" Opacity="0.55"
                                                               VerticalAlignment="Center" />
                                                </WrapPanel>
                                                </DockPanel>

                                                <TextBlock Grid.Column="2" Text="{l:Tr mods-downloading}" FontSize="11"
                                                           Opacity="0.6" VerticalAlignment="Center"
                                                           IsVisible="{Binding Downloading}" />

                                                <TextBlock Grid.Column="2" Text="{l:Tr mods-loading}" FontSize="11"
                                                           Opacity="0.6" VerticalAlignment="Center"
                                                           IsVisible="{Binding LoadingReleases}" />

                                                <!-- Offered, never applied on its own. -->
                                                <Button Grid.Column="2" Padding="10,4"
                                                        Classes="accent"
                                                        IsVisible="{Binding HasUpdate}"
                                                        Command="{Binding UpdateCommand}"
                                                        Content="{Binding UpdateNote}"
                                                        VerticalAlignment="Center" />

                                                <!--
                                                    One control, two meanings: unpinned it
                                                    asks which version, pinned it unpins.
                                                    Its releases are fetched when it is
                                                    pressed, not for every row up front. A
                                                    dependency has no pin of its own — it is
                                                    whatever the mod that requires it needs.
                                                -->
                                                <Button Grid.Column="3" x:Name="PinButton"
                                                        Padding="10,4"
                                                        IsVisible="{Binding CanChange}"
                                                        Command="{Binding TogglePinCommand}"
                                                        ToolTip.Tip="{Binding PinTip}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <!--
                                                            Drawn rather than a glyph: 📌 is
                                                            an emoji, so it renders in colour
                                                            at whatever weight the font feels
                                                            like, beside a ✕ that is neither.
                                                            Bars in the button's own ink match
                                                            it at any scale.
                                                        -->
                                                        <Path Width="12" Height="12"
                                                              Stretch="Uniform"
                                                              Fill="{DynamicResource VsButtonTextBrush}"
                                                              Opacity="{Binding PinOpacity}"
                                                              VerticalAlignment="Center"
                                                              Data="M 1,1 H 13 V 4.5 H 1 Z M 6,4.5 H 8 V 14 H 6 Z">
                                                            <!-- Upright, the head and shaft
                                                                 read as a letter T sitting
                                                                 between View and ✕. Turned,
                                                                 the same two bars read as a
                                                                 tack pushed into the row. -->
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="-45" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <!-- Only when pinned; see PinLabel. -->
                                                        <TextBlock Text="{Binding PinLabel}"
                                                                   IsVisible="{Binding IsPinned}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="4" Content="{l:Tr mods-view}" Padding="10,4"
                                                        Command="{Binding OpenPageCommand}"
                                                        VerticalAlignment="Center" />
                                                <!-- Removing a dependency while the mod that
                                                     needs it is still here would only be undone
                                                     by the next sync. -->
                                                <Button Grid.Column="5" Content="✕" Padding="10,4"
                                                        IsVisible="{Binding CanChange}"
                                                        Command="{Binding RequestRemoveCommand}"
                                                        VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Asks in the row, so which mod is meant is never
                                                 in doubt. -->
                                            <Border IsVisible="{Binding ConfirmingRemove}"
                                                    Background="{DynamicResource VsErrorFillBrush}"
                                                    BorderBrush="{DynamicResource VsErrorBrush}"
                                                    BorderThickness="1" CornerRadius="1" Padding="8,5">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding RemovePrompt}" />
                                                    <Button Grid.Column="1" Content="{l:Tr mods-remove}" Classes="accent"
                                                            Padding="12,3"
                                                            Command="{Binding ConfirmRemoveCommand}" />
                                                    <Button Grid.Column="2" Content="{l:Tr mods-keep}" Padding="12,3"
                                                            Command="{Binding CancelRemoveCommand}" />
                                                </Grid>
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- The results -->
                                <ListBox IsVisible="{Binding Detail.ShowingSearch}"
                                         ItemsSource="{Binding Detail.SearchHits}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchHitViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"
                                                  Margin="0,4">
                                                <!-- Fixed-size well so rows stay aligned whether
                                                     or not the mod has an icon, and whether or
                                                     not it has arrived yet. -->
                                                <Border Grid.Column="0" Width="40" Height="40"
                                                        Classes="sunken" VerticalAlignment="Top">
                                                    <Image Source="{Binding Icon}"
                                                           IsVisible="{Binding HasIcon}"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ModId}" FontSize="11" Opacity="0.6"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Side}" FontSize="11" Opacity="0.6"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Downloads}" FontSize="11" Opacity="0.5"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Author}" FontSize="11" Opacity="0.5"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- On its own line, and left-aligned so it
                                                         hugs its text. It sat on the title row
                                                         until a long enough name pushed it under
                                                         the View and Add buttons: a horizontal
                                                         StackPanel does not wrap, it overflows
                                                         into whatever is beside it. -->
                                                    <Border IsVisible="{Binding Incompatible}"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource VsWarningFillBrush}"
                                                            BorderBrush="{DynamicResource VsWarningBrush}"
                                                            BorderThickness="1" CornerRadius="1"
                                                            Padding="5,1" Margin="0,1">
                                                        <TextBlock Text="{Binding NoReleaseNote}" FontSize="10"
                                                                   Foreground="{DynamicResource VsWarningBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Tags}" FontSize="10" Opacity="0.45"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="{l:Tr mods-hit-view}" Padding="10,4"
                                                        Command="{Binding OpenPageCommand}"
                                                        VerticalAlignment="Center" />

                                                <!-- Just "Add", for every row. The badge beside
                                                     the mod already says there is no release for
                                                     this version, and the confirmation says the
                                                     rest — a second warning in the button only
                                                     made the column wider. -->
                                                <Button Grid.Column="3" Content="{l:Tr mods-hit-add}"
                                                        Classes="accent"
                                                        Padding="14,4" MinWidth="64"
                                                        IsVisible="{Binding !AlreadyInPack}"
                                                        Command="{Binding AddCommand}"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{l:Tr mods-hit-in-pack}" FontSize="11"
                                                           IsVisible="{Binding AlreadyInPack}"
                                                           Foreground="{DynamicResource VsParchmentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Which nothing this is, and what to do about it. An empty
                                     list under a pack of a hundred and fifty mods otherwise
                                     reads as a pack that has lost them — and this is the
                                     moment the other half of the box is worth knowing
                                     about. -->
                                <TextBlock Text="{Binding Detail.NoModsMatchLine}"
                                           IsVisible="{Binding Detail.ShowNoModsMatch, FallbackValue=False}"
                                           Margin="2,8,0,0" FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Top" TextWrapping="Wrap" />
                            </Panel>
                        </DockPanel>
                    </TabItem>

                    <!-- Pack settings -->
                    <TabItem Header="{l:Tr tab-settings}">
                      <!--
                          This tab had no ScrollViewer, so everything below the fold was
                          unreachable rather than merely out of view — including Delete,
                          which sits at the bottom by design.
                      -->
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0" Spacing="12" MaxWidth="460" HorizontalAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:Tr packsettings-name}" FontSize="12" Opacity="0.7" />
                                <TextBox x:Name="SettingsName"
                                         Text="{Binding Detail.EditName}"
                                         LostFocus="OnSettingsFieldLostFocus" />
                            </StackPanel>

                            <!-- Travels with the pack, so it is worth writing before
                                 sharing rather than after somebody asks what it is. -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:Tr packsettings-description}" FontSize="12" Opacity="0.7" />
                                <TextBox x:Name="SettingsDescription"
                                         Text="{Binding Detail.EditDescription}"
                                         LostFocus="OnSettingsFieldLostFocus"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                         Watermark="{l:Tr packsettings-description-watermark}" />
                                <TextBlock Text="{Binding Detail.DescriptionRoom}" FontSize="11"
                                           Opacity="0.55" HorizontalAlignment="Right" />
                            </StackPanel>
                            <!--
                                Changing the game version re-resolves every mod, so it is
                                not a field you edit and save with the others: picking one
                                works out what it would do and asks. Nothing is written
                                until that is confirmed, and declining puts the picker back
                                — so the control always shows the version the pack is on.
                            -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:Tr packsettings-game-version}" FontSize="12" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="GameVersionChoice" MinWidth="150"
                                              IsEnabled="{Binding !Detail.IsCheckingVersion}"
                                              ItemsSource="{Binding Detail.GameVersionChoices}"
                                              SelectedItem="{Binding Detail.TargetGameVersion}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                                               IsVisible="{Binding Detail.IsCheckingVersion}"
                                               Text="{Binding Detail.CheckingMod, StringFormat='checking {0}…'}" />
                                </StackPanel>
                            </StackPanel>

                            <!--
                                What this pack runs, when it is not simply the stock game.
                                A sentence rather than a picker: there is one modified
                                client Cairn can produce, so listing every install asked
                                somebody to choose from two entries with one obvious answer.
                            -->
                            <TextBlock x:Name="InstallNote"
                                       Text="{Binding Detail.InstallChoiceLine}"
                                       FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.HasInstallNote, FallbackValue=False}"
                                       Foreground="{DynamicResource VsWarningBrush}" />

                            <!--
                                One action at a time: make it, use it, point at your own, or
                                stop. Always present now — it used to be hidden on versions
                                Optimum has no revision for, which turned out to hide it from
                                exactly the person who had built one themselves. See
                                HasOptimumPanel.
                            -->
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding Detail.HasOptimumPanel, FallbackValue=False}">
                                <TextBlock Text="{l:Tr packsettings-optimum}" FontSize="12" Opacity="0.7" />

                                <!-- Wraps, because two buttons side by side are wider than
                                     the settings column at the window's minimum width. -->
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                    <Button x:Name="BuildOptimum"
                                            Content="{Binding Detail.BuildOptimumLabel}"
                                            IsVisible="{Binding Detail.CanBuildOptimum}"
                                            Command="{Binding Detail.BuildOptimumCommand}"
                                            Padding="12,5" />

                                    <Button x:Name="UseOptimum" Content="{l:Tr packsettings-use-optimum}"
                                            IsVisible="{Binding Detail.CanUseOptimum}"
                                            Command="{Binding Detail.UseOptimumCommand}"
                                            Padding="12,5" />

                                    <!-- One click, no picker: the folder was chosen once,
                                         for the machine rather than for this pack. -->
                                    <Button x:Name="UseExternalClient"
                                            Content="{l:Tr packsettings-use-external}"
                                            IsVisible="{Binding Detail.CanUseExternal}"
                                            Command="{Binding Detail.UseExternalCommand}"
                                            Padding="12,5" />

                                    <!-- Without this, running a modified client would be a
                                         decision nothing on screen could undo. -->
                                    <Button x:Name="UseStockGame" Content="{l:Tr packsettings-use-stock}"
                                            IsVisible="{Binding Detail.IsUsingVariant}"
                                            Command="{Binding Detail.UseStockGameCommand}"
                                            Padding="12,5" />

                                    <!-- Reads as "point somewhere else" once a client of
                                         theirs is already in use, because that is what
                                         pressing it then does. -->
                                    <Button x:Name="AdoptClient"
                                            Content="{l:Tr packsettings-use-own}"
                                            IsVisible="{Binding !Detail.IsUsingExternal}"
                                            Command="{Binding Detail.AdoptClientCommand}"
                                            Padding="12,5" />

                                    <Button x:Name="RepointClient"
                                            Content="{l:Tr packsettings-point-elsewhere}"
                                            IsVisible="{Binding Detail.IsUsingExternal}"
                                            Command="{Binding Detail.AdoptClientCommand}"
                                            Padding="12,5" />
                                </WrapPanel>

                                <!-- Where their client is. Trimmed rather than wrapped: it
                                     is a reference, not a sentence, and a three-line path
                                     pushes the buttons off the panel. -->
                                <TextBlock x:Name="ExternalClientPath"
                                           Text="{Binding Detail.ExternalPathLine}"
                                           ToolTip.Tip="{Binding Detail.ExternalPathLine}"
                                           IsVisible="{Binding Detail.HasExternalPathLine}"
                                           FontSize="11" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Why the folder just picked was not taken. Inline, not a
                                     dialog: nothing was committed and the picker is one
                                     click away. -->
                                <TextBlock x:Name="AdoptProblem"
                                           Text="{Binding Detail.AdoptProblem}"
                                           IsVisible="{Binding Detail.HasAdoptProblem}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VsWarningBrush}" />

                                <!-- Which version a build would be for, while the version
                                     picker shows another. Disabled without this is a
                                     mystery. -->
                                <TextBlock x:Name="BuildOptimumBlocked"
                                           Text="{Binding Detail.BuildOptimumBlockedNote}"
                                           IsVisible="{Binding Detail.HasBuildOptimumBlockedNote}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VsWarningBrush}" />

                                <!-- Says a different thing depending on whether Cairn has a
                                     build to offer here; empty once one is running. -->
                                <TextBlock x:Name="OwnClientExplain"
                                           FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                                           Text="{Binding Detail.OwnClientExplain}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:Tr packsettings-connect}"
                                           FontSize="12" Opacity="0.7" />
                                <TextBox x:Name="SettingsConnect"
                                         Text="{Binding Detail.EditConnect}"
                                         LostFocus="OnSettingsFieldLostFocus" />
                                <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                           Text="{l:Tr packsettings-connect-note}" />
                            </StackPanel>

                            <!--
                                Each field above commits as focus leaves it, so this is not
                                how edits normally reach the disk. It stays because the
                                description cap needs somewhere to refuse from: one too long
                                to commit sits in the box with this disabled beneath it,
                                which is what says the words are still only on screen.
                                Enabled at any other time means the same thing.

                                Delete is deliberately not beside it; it lives with the
                                other destructive affordance in the sidebar.
                            -->
                            <Button Content="{l:Tr packsettings-save}" Classes="accent" HorizontalAlignment="Left"
                                    Command="{Binding Detail.SaveSettingsCommand}" Padding="18,6" />

                            <!-- Both paths have always been printed here, which is a fine
                                 thing to read and a poor thing to retype into a file
                                 manager. The button is beside the path rather than replacing
                                 it: the path is also what somebody quotes when asking for
                                 help. -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Tr packsettings-mods-dir}" FontSize="12" Opacity="0.7" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding Detail.ModsDirectory}"
                                               FontSize="11" Opacity="0.6"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" x:Name="OpenModsFolder"
                                            Content="{l:Tr packsettings-open-folder}"
                                            VerticalAlignment="Center" Padding="12,3" FontSize="11"
                                            Command="{Binding Detail.OpenModsFolderCommand}" />
                                </Grid>
                            </StackPanel>

            <StackPanel Spacing="4">
                                <TextBlock Text="{l:Tr packsettings-worlds}" FontSize="12" Opacity="0.7" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding Detail.DataDirectory}"
                                               FontSize="11" Opacity="0.6"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" x:Name="OpenDataFolder"
                                            Content="{l:Tr packsettings-open-folder}"
                                            VerticalAlignment="Center" Padding="12,3" FontSize="11"
                                            Command="{Binding Detail.OpenDataFolderCommand}" />
                                </Grid>
                                <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                           Text="{l:Tr packsettings-worlds-explain}" />
                            </StackPanel>

                            <!-- A pack's data path is its own, so a world in the player's
                                 plain install is not reachable from the pack holding the
                                 mods it was made with. Offered here as well as at import,
                                 because a pack that already exists has no other way to it. -->
                            <StackPanel Spacing="6" IsVisible="{Binding Detail.HasWorldsToImport,
                                                                       FallbackValue=False}">
                                <TextBlock Text="{l:Tr packsettings-bring-world}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{l:Tr packsettings-bring-world-explain}" />
                                <Button Content="{l:Tr packsettings-choose-world}" HorizontalAlignment="Left"
                                        Command="{Binding Detail.ImportWorldsCommand}" />
                            </StackPanel>

                            <Separator Margin="0,4" />

                            <StackPanel Spacing="6"
                                        IsVisible="{Binding Detail.CanShareFile, FallbackValue=True}">
                                <TextBlock Text="{l:Tr packsettings-share}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{l:Tr packsettings-share-explain}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{l:Tr packsettings-export}" Command="{Binding Detail.ExportCommand}" />
                                    <CheckBox Content="{l:Tr packsettings-include-lock}"
                                              IsChecked="{Binding Detail.ExportIncludesLock}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail.ExportedPath}"
                                           IsVisible="{Binding Detail.HasExported}"
                                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                <TextBox Text="{Binding Detail.ExportedJson}"
                                         IsVisible="{Binding Detail.HasExported}"
                                         IsReadOnly="True" AcceptsReturn="True" Height="120"
                                         FontFamily="monospace" FontSize="11" />
                            </StackPanel>

                            <!-- Says where the export controls went. An export carries no
                                 canonical URL and no author, so a file made from somebody
                                 else's pack would reach the next person as an unowned one. -->
                            <StackPanel Spacing="6"
                                        IsVisible="{Binding Detail.IsFollowing, FallbackValue=False}">
                                <TextBlock Text="{l:Tr packsettings-share-follower}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{l:Tr packsettings-share-follower-explain}" />
                                <TextBlock Text="{Binding Detail.ShareUrlLine}" FontSize="11"
                                           Opacity="0.8" TextWrapping="Wrap" />
                            </StackPanel>

                            <Separator Margin="0,4" />

                            <!--
                                Deleting lives with the pack it deletes, at the end of its
                                own settings. The label says what it does; what it costs
                                belongs in the confirmation, where it is read.
                            -->
                            <StackPanel Spacing="6">
                                <Button Content="{l:Tr packsettings-delete}" HorizontalAlignment="Left" Padding="14,5"
                                        Command="{Binding RequestDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>

                    <!--
                        Twenty mods bring twenty sets of hotkeys and several land on the
                        same key. The author sorts that out once here; everybody who
                        installs the pack gets the answer on first launch and never learns
                        there was a question.
                    -->
                    <TabItem Header="{l:Tr tab-hotkeys}">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                <TextBlock Text="{Binding Detail.HotkeySummary}" FontSize="12"
                                           Opacity="0.75" TextWrapping="Wrap" />

                                <!-- Forty hotkeys is a scroll, and the one you want is
                                     usually one you can already name — or the only ones
                                     that matter are the ones colliding. -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <TextBox Grid.Column="0" Text="{Binding Detail.HotkeySearch}"
                                             PlaceholderText="{l:Tr hotkeys-search-placeholder}" />
                                    <!-- The count rides on the control you would use next,
                                         rather than in a banner above a list that is about
                                         to show you the same thing. -->
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                              Content="{Binding Detail.OnlyClashesLabel}"
                                              IsChecked="{Binding Detail.OnlyClashes}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               FontSize="11" Opacity="0.6"
                                               Text="{Binding Detail.HotkeyListLine}" />
                                </Grid>

                                <!-- Read out of the mod files, so it is known before the
                                     pack has ever been launched. -->
                                <Border IsVisible="{Binding Detail.LoadingHotkeys, FallbackValue=False}"
                                        Classes="sunken" Padding="10,7">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <ProgressBar Grid.Column="0" Width="90" Height="6"
                                                     IsIndeterminate="True" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                                   Text="{l:Tr hotkeys-reading}" />
                                    </Grid>
                                </Border>

                            </StackPanel>

            <!-- No Save button: rebinding writes the pack, the same as adding a mod or
                 pinning a version. A second step is how edits sat unsaved and were thrown
                 away by selecting another pack. -->
                            <TextBlock DockPanel.Dock="Bottom" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{l:Tr hotkeys-footer}" />

                            <!-- Says which nothing this is: a search that found none, or a
                                 pack with no collisions left in it. -->
                            <TextBlock DockPanel.Dock="Top" Margin="0,14,0,0" FontSize="12"
                                       Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.ShowNoHotkeysFound, FallbackValue=False}"
                                       Text="{Binding Detail.NoHotkeysFoundLine}" />

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Detail.Hotkeys}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                                            <Border Padding="8,6" Margin="0,0,0,4" Classes="sunken">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Display}" FontSize="12" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.55"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <!-- Stays up after unlocking: the row is still one
                                                                 whose key somebody's hands know. -->
                                                            <TextBlock Text="{Binding ControlLabel}" FontSize="11"
                                                                       Foreground="{DynamicResource VsParchmentBrush}"
                                                                       Opacity="0.75"
                                                                       IsVisible="{Binding ShowControlLabel}" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" IsVisible="{Binding ShowClash}"
                                                                   Foreground="{DynamicResource VsWarningBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding ClashesWith, StringFormat='same key as {0}'}" />

                                                        <!-- Sharing a held key is the design, not a
                                                             problem: said plainly, in the ordinary
                                                             colour, and not counted as a conflict. -->
                                                        <TextBlock FontSize="11" IsVisible="{Binding ShowSharedKey}"
                                                                   Opacity="0.55" TextWrapping="Wrap"
                                                                   Text="{Binding SharedKeyLine}" />
                                                    </StackPanel>

                                                    <!-- The mod's own default, kept beside the
                                                         pack's choice: "is that what it ships
                                                         or what I picked?" is the question the
                                                         tab exists to answer. -->
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               FontSize="11" Opacity="0.5" MinWidth="90"
                                                               IsVisible="{Binding IsOverridden}"
                                                               Text="{Binding DefaultText, StringFormat='was {0}'}" />

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="{Binding ButtonLabel}" MinWidth="110"
                                                                Command="{Binding CaptureCommand}"
                                                                IsEnabled="{Binding CanEdit}"
                                                                Classes.accent="{Binding Capturing}" />

                                                        <!-- Movement and the mouse are held back rather than
                                                             forbidden: an author moving Sit down off G has a
                                                             reason, and saying so first makes it a decision. -->
                                                        <Button Content="{l:Tr hotkeys-unlock}" Command="{Binding UnlockCommand}"
                                                                IsVisible="{Binding ShowUnlock}"
                                                                ToolTip.Tip="{l:Tr hotkeys-unlock-tip}" />

                                                        <!-- The third answer to a collision, and often the right
                                                             one: five mods want P and four of them do not need
                                                             a key at all. -->
                                                        <Button Content="{l:Tr hotkeys-unbind}" Command="{Binding UnbindCommand}"
                                                                IsVisible="{Binding CanEdit}"
                                                                IsEnabled="{Binding !IsUnbound}"
                                                                ToolTip.Tip="{l:Tr hotkeys-unbind-tip}" />

                                                        <Button Content="{l:Tr hotkeys-reset}" Command="{Binding ClearCommand}"
                                                                IsVisible="{Binding IsOverridden}"
                                                                ToolTip.Tip="{l:Tr hotkeys-reset-tip}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!--
                        Two mods often need a line in one of their config files before they
                        work together. The author changes it in game, where they can see what
                        it does, and ticks it here so it travels — instead of writing "and go
                        and edit this file" in the pack description.
                    -->
                    <TabItem Header="{l:Tr tab-modconfig}">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top" Spacing="8">
                                <TextBlock Text="{Binding Detail.ModConfigSummary}" FontSize="12"
                                           Opacity="0.75" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                    <TextBox Grid.Column="0" Text="{Binding Detail.ModConfigSearch}"
                                             PlaceholderText="{l:Tr modconfig-search-placeholder}" />

                                    <!-- A value changed during the very first session was in
                                         the file before anything saw it, so it never reads as
                                         changed. This is how somebody finds it anyway. -->
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                              Content="{l:Tr modconfig-show-all}"
                                              IsChecked="{Binding Detail.ShowAllSettings}"
                                              ToolTip.Tip="{l:Tr modconfig-show-all-tip}" />

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               FontSize="11" Opacity="0.6"
                                               Text="{Binding Detail.ModConfigListLine}" />
                                </Grid>

                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VsWarningBrush}"
                                           IsVisible="{Binding Detail.ModConfigError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Text="{Binding Detail.ModConfigError}" />
                            </StackPanel>

            <!-- No Save button, the same as Hotkeys: ticking writes the pack. A second
                 step is how edits sat unsaved and were thrown away by selecting another
                 pack. The one button here opens the folder these files are actually in,
                 which is otherwise a path nobody should have to know. -->
                            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10" Margin="0,8,0,0">
                                <Button Grid.Column="0" Content="{l:Tr modconfig-open-folder}"
                                        VerticalAlignment="Center"
                                        Command="{Binding Detail.OpenModConfigFolderCommand}"
                                        ToolTip.Tip="{Binding Detail.ModConfigFolder}" />

                                <TextBlock Grid.Column="1" FontSize="11" Opacity="0.6"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{l:Tr modconfig-footer}" />
                            </Grid>

                            <TextBlock DockPanel.Dock="Top" Margin="0,14,0,0" FontSize="12"
                                       Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding Detail.ShowNoModConfigFound, FallbackValue=False}"
                                       Text="{Binding Detail.NoModConfigFoundLine}" />

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Detail.ModConfigSettings}" Margin="0,8,0,0">
                                    <!-- Show all on a real pack is two thousand rows — 98
                                         config files, 2045 settings, measured. The default
                                         stack panel realises every one of them and the tab
                                         takes seconds to open. Hotkeys gets away without
                                         this at forty rows; this cannot. -->
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModConfigRowViewModel">
                                            <!-- Double-click shows this row's file in the
                                                 file manager, the way double-clicking a mod
                                                 opens its page. A button on the row would be
                                                 two thousand buttons on a real pack, for
                                                 something the folder button below already
                                                 half does. -->
                                            <Border Padding="8,6" Margin="0,0,0,4" Classes="sunken"
                                                    DoubleTapped="OnModConfigRowDoubleTapped">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <!-- The whole of what a row decides: does
                                                         this value travel with the pack? -->
                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                              IsChecked="{Binding Carried}"
                                                              ToolTip.Tip="{l:Tr modconfig-carry-tip}" />

                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Key}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding File}" FontSize="11" Opacity="0.55"
                                                                   ToolTip.Tip="{l:Tr modconfig-reveal-tip}"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <TextBlock FontSize="11" IsVisible="{Binding IsOrphan}"
                                                                   Foreground="{DynamicResource VsWarningBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding OrphanLine}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                Spacing="10" VerticalAlignment="Center">
                                                        <!-- What the mod first wrote, kept beside
                                                             what it says now: "is that what it
                                                             ships or what I picked?" is the
                                                             question the tab answers. -->
                                                        <TextBlock VerticalAlignment="Center" FontSize="11"
                                                                   Opacity="0.5" MaxWidth="160"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding ShowBaseline}"
                                                                   Text="{Binding WasText}" />

                                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                                   MinWidth="70" MaxWidth="200"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding CurrentText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="{l:Tr tab-log}">
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <!--
                                Cairn's log is only half the story: when the game closes on
                                startup the answer is in its own log, which nobody should
                                have to know the location of.
                            -->
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                        Spacing="8" Margin="0,8,0,0">
                                <Button Content="{l:Tr log-clear}" Command="{Binding Detail.ClearLogCommand}" />
                                <Button Content="{l:Tr log-game-log}"
                                        Command="{Binding Detail.ShowGameLogCommand}" />
                                <Button Content="{l:Tr log-open-folder}"
                                        Command="{Binding Detail.OpenLogsFolderCommand}" />

                                <!--
                                    Beside the log because that is where somebody already is
                                    when the thing they want to report has just happened.
                                    There is no "report an issue" beside it: Cairn has no
                                    public tracker yet, and a button that opens one would be
                                    sending people somewhere that cannot receive them.
                                -->
                                <Button Content="{l:Tr log-copy-diagnostics}"
                                        Command="{Binding Detail.CopyDiagnosticsCommand}"
                                        ToolTip.Tip="{l:Tr log-copy-diagnostics-tip}" />
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Detail.Log}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontFamily="monospace" FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </DockPanel>
        </Panel>
    </DockPanel>
</Window>
