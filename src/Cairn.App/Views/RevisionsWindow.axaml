<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Cairn.App"
        xmlns:vm="using:Cairn.App.ViewModels"
        x:Class="Cairn.App.Views.RevisionsWindow"
        x:DataType="vm:RevisionsViewModel"
        Title="{Binding Title}"
        Width="640" Height="600"
        MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsWindowBrush}">

    <!--
        Revisions on the left, what the chosen one would do on the right. The same habit as
        the other decision windows: the button that commits stays in view however long
        either list gets.
    -->
    <DockPanel Margin="16" LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Text="{l:Tr revisions-explain}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    Spacing="8" Margin="0,12,0,0">
            <Button Name="RestoreButton" Content="{Binding RestoreLabel}" Classes="accent"
                    Padding="16,5" IsEnabled="{Binding CanRestore}" Click="OnRestore" />
            <Button Name="CancelButton" Content="{l:Tr common-cancel}" Padding="16,5"
                    Click="OnCancel" IsCancel="True" />
        </StackPanel>

        <!--
            Declared after the buttons because bottom-docked children stack upwards, which is
            what puts it directly above them. In the error colours, and there whatever is
            selected: this is the last thing read before pressing it. A restore can be undone
            by restoring again; a world opened without the mods it was played with cannot.
        -->
        <Border DockPanel.Dock="Bottom" Name="WorldWarning" Margin="0,12,0,0"
                IsVisible="{Binding HasChoices}"
                Padding="12,10" CornerRadius="1" BorderThickness="2"
                Background="{DynamicResource VsErrorFillBrush}"
                BorderBrush="{DynamicResource VsErrorBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="{l:Tr restore-worlds-heading}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource VsErrorBrush}" />
                <TextBlock Text="{Binding WorldWarning}" FontSize="12" TextWrapping="Wrap" />
                <Button Content="{l:Tr revisions-open-worlds}" Padding="10,3" FontSize="11"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding CanOpenWorlds}"
                        Command="{Binding OpenWorldsCommand}" />
            </StackPanel>
        </Border>

        <TextBlock Name="EmptyNote" Text="{Binding EmptyNote}"
                   IsVisible="{Binding !HasChoices}"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource VsWarningBrush}" />

        <Grid ColumnDefinitions="190,*" ColumnSpacing="12" IsVisible="{Binding HasChoices}">

            <ListBox Grid.Column="0" Name="Revisions"
                     ItemsSource="{Binding Choices}"
                     SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RevisionChoiceViewModel">
                        <StackPanel Spacing="1" Margin="0,3">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding When}" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.75"
                                       IsVisible="{Binding HasNote}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Column="1" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Name="SummaryText" Text="{Binding Summary}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <TextBlock DockPanel.Dock="Top" Name="ErrorText" Text="{Binding Error}"
                           IsVisible="{Binding HasError}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource VsErrorBrush}" />

                <Border BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                        CornerRadius="1" Padding="2">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Changes}" Margin="8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RevisionChangeViewModel">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding ModId}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="11"
                                                   Opacity="0.75" FontFamily="monospace" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
