<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cairn.App.ViewModels"
        x:Class="Cairn.App.Views.WorldImportWindow"
        x:DataType="vm:WorldPickerViewModel"
        Title="Bring in a world"
        Width="520" MinWidth="420" MaxHeight="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsWindowBrush}">

    <!-- Height follows the list, like the import dialog: one world and five are not the
         same dialog, and a window sized for five shows one in a field of nothing. -->
    <DockPanel Margin="16" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="Bring a world into this pack" FontSize="16" FontWeight="SemiBold" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8"
                       Text="A world only opens against the mods it was made with, so it belongs in the pack that has them. Ticked worlds are copied — your own stay exactly where they are." />
            <TextBlock Text="{Binding SavesDir}" FontSize="11" Opacity="0.55"
                       FontFamily="monospace" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="CopyButton" Content="Copy into pack" Classes="accent" Padding="16,5"
                        Click="OnCopy" IsEnabled="{Binding HasChosen}" />
                <Button Name="CancelButton" Content="Cancel" Padding="16,5"
                        Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                CornerRadius="1" Padding="2">
            <ScrollViewer Name="WorldList" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Worlds}" Margin="8,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorldRowViewModel">
                            <Grid ColumnDefinitions="*,90" Margin="0,3">
                                <CheckBox Grid.Column="0" IsChecked="{Binding Chosen}" FontSize="12">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastPlayed}" FontSize="11"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="11"
                                           Opacity="0.75" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
