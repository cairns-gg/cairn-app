<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Cairn.App"
        xmlns:vm="using:Cairn.App.ViewModels"
        x:Class="Cairn.App.Views.VersionChangeWindow"
        x:DataType="vm:VersionChangeViewModel"
        Title="{l:Tr versionchange-title}"
        Width="620" Height="520"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsWindowBrush}">

    <!--
        A dialog rather than a panel in the Settings tab: a pack can have dozens of mods,
        and the decision needs its verdicts scrollable with the two buttons that act on
        them always in view. Inline, a long list pushed Apply off the bottom of a tab that
        does not even scroll.
    -->
    <DockPanel Margin="16" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{l:Tr versionchange-nothing}" FontSize="11" Opacity="0.6" />
        </StackPanel>

        <!--
            Warnings and the buttons dock to the bottom before the list fills the middle,
            so they keep their space however many mods there are.
        -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding BreakWarning}" IsVisible="{Binding AnythingBreaks}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource VsErrorBrush}" />
            <TextBlock Text="{Binding IncompleteWarning}" IsVisible="{Binding IsIncomplete}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource VsErrorBrush}" />
            <TextBlock Text="{Binding WorldWarning}" IsVisible="{Binding RisksWorlds}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource VsErrorBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="ApplyButton" Content="{Binding ApplyLabel}"
                        Classes="accent" Padding="16,5" Click="OnApply" />
                <Button Name="CancelButton" Content="{l:Tr common-cancel}" Padding="16,5" Click="OnCancel" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                CornerRadius="1" Padding="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}" Margin="8,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModVerdictViewModel">
                            <Grid ColumnDefinitions="76,140,*" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           FontSize="11" FontFamily="monospace"
                                           Foreground="{DynamicResource VsErrorBrush}"
                                           IsVisible="{Binding Breaks}" />
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           FontSize="11" FontFamily="monospace" Opacity="0.75"
                                           IsVisible="{Binding !Breaks}" />
                                <TextBlock Grid.Column="1" Text="{Binding ModId}"
                                           FontSize="12" Margin="0,0,10,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Note}"
                                           FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
