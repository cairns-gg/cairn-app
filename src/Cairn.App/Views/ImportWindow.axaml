<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Cairn.App"
        xmlns:vm="using:Cairn.App.ViewModels"
        x:Class="Cairn.App.Views.ImportWindow"
        x:DataType="vm:ImportViewModel"
        Title="{l:Tr import-title}"
        Width="580" Height="520"
        MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsWindowBrush}">

    <!--
        Same shape as the share and version-change dialogs: the mods scroll, and what
        commits them keeps its place at the bottom however long the list is.
    -->
    <DockPanel Margin="16" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10">
            <TextBlock Text="{Binding PackName}" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Who and where, directly under the name. This is the whole basis on which
                 somebody can judge a link they were sent. -->
            <TextBlock Text="{Binding Provenance}" FontSize="11" Opacity="0.7"
                       TextWrapping="Wrap" />

            <!-- The author saying what it is for. The list below says what is in it, which
                 is not the same question. -->
            <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.85"
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">

            <!-- A pack can carry a server address, and adding it means the pack will
                 launch straight into somebody's server. Usually the point; never a
                 surprise worth saving for later. -->
            <Border IsVisible="{Binding HasConnect}" Padding="10,7" CornerRadius="1"
                    Background="{DynamicResource VsWarningFillBrush}"
                    BorderBrush="{DynamicResource VsWarningBrush}" BorderThickness="1">
                <TextBlock Text="{Binding ConnectNote}" FontSize="11" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{Binding VersionNote}" FontSize="11" Opacity="0.7"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{l:Tr import-install-as}" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" MinWidth="70" />
                <TextBox Grid.Column="1" Name="IdBox" Text="{Binding AsId}" />
            </Grid>

            <TextBlock Text="{Binding IdConflict}" IsVisible="{Binding HasIdConflict}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource VsErrorBrush}" />

            <!-- Neither is preselected for a file, so the address a follow would use is
                 read before it is agreed to rather than after. -->
            <StackPanel IsVisible="{Binding CanChooseFollow}" Spacing="6">
                <TextBlock Text="{l:Tr import-belongs}" FontSize="12" Opacity="0.7" />

                <RadioButton Name="FollowChoice" GroupName="FollowOrFork" FontSize="12"
                             IsChecked="{Binding FollowChosen, Mode=TwoWay}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Tr import-follow}" FontSize="12" />
                        <TextBlock Text="{Binding FollowNote}" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="ForkChoice" GroupName="FollowOrFork" FontSize="12"
                             IsChecked="{Binding ForkChosen, Mode=TwoWay}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Tr import-make-mine}" FontSize="12" />
                        <TextBlock Text="{Binding ForkNote}" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="AddButton" Content="{l:Tr import-add}" Classes="accent" Padding="16,5"
                        Click="OnAdd" IsEnabled="{Binding CanAdd}" />
                <Button Name="CancelButton" Content="{l:Tr common-cancel}" Padding="16,5"
                        Click="OnCancel" IsCancel="True" />
            </StackPanel>

            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Text="{l:Tr import-nothing-yet}" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                CornerRadius="1" Padding="2">
            <ScrollViewer Name="ModList"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}" Margin="8,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportModViewModel">
                            <Grid ColumnDefinitions="*,110,80" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding ModId}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="11"
                                           Opacity="0.75" FontFamily="monospace" />
                                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11"
                                           Opacity="0.6" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
