<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cairn.App.ViewModels"
        x:Class="Cairn.App.Views.ShareWindow"
        x:DataType="vm:ShareViewModel"
        Title="{Binding Title}"
        Width="600" Height="540"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsWindowBrush}">

    <!--
        Same shape as the version-change dialog, because it is the same kind of screen: a
        decision that is awkward to take back, where the mods scroll and the thing that
        commits them stays in view.
    -->
    <DockPanel Margin="16" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="{Binding SignedInAs}" FontSize="11" Opacity="0.7"
                       IsVisible="{Binding IsSignedIn}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="URL" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" MinWidth="70" />
                <!-- Read-only once published: on this server the URL is the pack, so a
                     different slug is a second pack rather than a move. -->
                <TextBox Grid.Column="1" Text="{Binding Slug}"
                         IsReadOnly="{Binding SlugFixed}" />
            </Grid>

            <TextBlock Text="{Binding UrlPreview}" FontSize="11" Opacity="0.55"
                       Margin="78,0,0,0" />

            <TextBlock Text="{Binding SlugNote}" IsVisible="{Binding SlugFixed}"
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       Margin="78,0,0,0" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Visibility" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" MinWidth="70" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <RadioButton GroupName="visibility" Content="Public — listed in browse"
                                 IsChecked="{Binding IsPublic}" FontSize="12" />
                    <RadioButton GroupName="visibility" Content="Unlisted — anyone with the link"
                                 IsChecked="{Binding !IsPublic}" FontSize="12" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!--
            Warnings and buttons dock before the list fills the middle, so they keep their
            space however many mods the pack has.
        -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">

            <!-- Surfaced every time rather than only when public: publishing a real host
                 and port is not something to discover afterwards. -->
            <Border IsVisible="{Binding HasConnect}" Padding="10,7" CornerRadius="1"
                    Background="{DynamicResource VsErrorFillBrush}"
                    BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ConnectWarning}" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton GroupName="connect" Content="Strip it" FontSize="11"
                                     IsChecked="{Binding StripConnect}" />
                        <RadioButton GroupName="connect" Content="Include it" FontSize="11"
                                     IsChecked="{Binding !StripConnect}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding UnresolvableWarning}" IsVisible="{Binding AnythingUnresolvable}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource VsWarningBrush}" />

            <TextBlock Text="{Binding LockProblem}" IsVisible="{Binding CannotPublish}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource VsErrorBrush}" />

            <!-- Says why Publish is dim. Changing the visibility or the server address
                 makes it go away, which is the point of still being able to open this on a
                 pack that has not otherwise changed. -->
            <TextBlock Text="{Binding UnchangedNote}" IsVisible="{Binding NothingToPublish}"
                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="PublishButton" Content="{Binding PublishLabel}"
                        Classes="accent" Padding="16,5" Click="OnPublish"
                        IsEnabled="{Binding CanPublish}" />
                <Button Name="CancelButton" Content="Cancel" Padding="16,5" Click="OnCancel" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                CornerRadius="1" Padding="2">
            <ScrollViewer Name="ModList"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}" Margin="8,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PublishModViewModel">
                            <Grid ColumnDefinitions="*,110,110" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding ModId}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="11"
                                           Opacity="0.75" FontFamily="monospace" />
                                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11"
                                           Opacity="0.65" IsVisible="{Binding !Missing}" />
                                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11"
                                           IsVisible="{Binding Missing}"
                                           Foreground="{DynamicResource VsWarningBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
