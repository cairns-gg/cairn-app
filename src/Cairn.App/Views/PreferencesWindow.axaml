<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cairn.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="620"
        x:Class="Cairn.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Width="880" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/cairn.ico"
        Title="Cairn Preferences">

    <DockPanel LastChildFill="True" Margin="16">

        <TabControl>

            <!--
                First, so it is what opens — including from the macOS About item, which
                arriving on a disk-usage screen made look like the wrong menu entry.
                What this holds is what you come here to read rather than to change: which
                version this is, where things live, and the one setting that is not about
                any particular pack.
            -->
            <TabItem Header="Overview">
                <StackPanel Margin="0,14,0,0" Spacing="16">
                    <!-- First within the tab, because it is what somebody opens this
                         looking for when reporting that something is broken. -->
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="VERSION" />
                        <TextBlock Classes="value" Text="{Binding Version}" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="CAIRN HOME" />
                        <TextBlock Classes="value" Text="{Binding CairnHome}" />
                        <TextBlock Classes="hint"
                                   Text="Packs, game versions, runtimes and caches. Set CAIRN_HOME to move it." />
                    </StackPanel>

                    <Separator Margin="0,4" />

                    <StackPanel Spacing="6" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Classes="label" Text="INTERFACE SIZE" />

                        <ComboBox MinWidth="140"
                                  ItemsSource="{Binding ScaleChoices}"
                                  SelectedItem="{Binding SelectedScale}" />

                        <TextBlock Classes="hint"
                                   Text="Scales everything — text, buttons, rows and spacing — rather than only the font, so nothing ends up cramped inside a control that stayed the same size. Applies straight away and is remembered." />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!--
                Play only ever adds game versions and runtimes, so this is the one place
                that takes them back.
            -->
            <TabItem Header="Storage">
                <DockPanel LastChildFill="True" Margin="0,10,0,0">

                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
                        <TextBlock FontSize="13">
                            <Run Text="Cairn is using" />
                            <Run Text="{Binding TotalSize}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource VsParchmentBrush}" />
                            <Run Text="in" />
                            <Run Text="{Binding CairnHome}" />
                        </TextBlock>

                        <!--
                            Every cell is centred in its row and the sizes share one font.
                            Mixing a default-size label with a 12pt detail and letting the
                            default vertical alignment (Stretch, so top) stand left the
                            three columns visibly off each other's baseline.
                        -->
                        <Grid ColumnDefinitions="180,90,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="8">
                            <Grid.Styles>
                                <Style Selector="Grid > TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                                <Style Selector="Grid > TextBlock.size">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                                <Style Selector="Grid > TextBlock.detail">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Style>
                            </Grid.Styles>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Game versions" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="size" Text="{Binding GamesSize}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Classes="detail" Text="{Binding GamesDetail}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET runtimes" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="size" Text="{Binding RuntimesSize}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Classes="detail" Text="{Binding RuntimesDetail}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Cached icons and details" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="size" Text="{Binding CacheSize}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="detail"
                                       Text="re-fetched as needed" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Packs" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="size" Text="{Binding PacksSize}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Classes="detail" Text="{Binding PacksDetail}" />

                            <!--
                                Worth its own row and its own button: it is the one thing
                                here somebody has a reason to clear deliberately, when an
                                author has just published and Cairn is still repeating the
                                answer it remembered.
                            -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Remembered update checks"
                                       IsVisible="{Binding HasUpdateChecks}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Classes="detail"
                                       IsVisible="{Binding HasUpdateChecks}"
                                       Text="{Binding UpdateChecksDetail}" />
                            <Button Grid.Row="5" Grid.Column="3" x:Name="ClearUpdateChecks"
                                    Content="Forget" Padding="14,4"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasUpdateChecks}"
                                    IsEnabled="{Binding NotCleaningUp}"
                                    Command="{Binding ClearUpdateChecksCommand}" />

                            <!--
                                Shown only when there is one, because most machines never
                                build a client. It is the largest thing Cairn writes, so
                                leaving it out of this table made gigabytes unaccountable —
                                but it is not in the sweep above, because what it removes
                                comes back after twenty minutes of compiling rather than
                                on its own.
                            -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Client build trees"
                                       IsVisible="{Binding HasBuildTrees}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="size"
                                       IsVisible="{Binding HasBuildTrees}"
                                       Text="{Binding BuildsSize}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Classes="detail"
                                       IsVisible="{Binding HasBuildTrees}"
                                       Text="{Binding BuildsDetail, StringFormat='{}{0} — kept so a rebuild is quick'}" />
                            <Button Grid.Row="4" Grid.Column="3"
                                    Content="Remove" Padding="14,4"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasBuildTrees}"
                                    IsEnabled="{Binding NotCleaningUp}"
                                    Command="{Binding RemoveBuildTreesCommand}" />

                            <!--
                                One sweep for everything that comes back on its own: unused
                                game versions, orphaned runtimes and the caches. Spans the
                                rows it acts on rather than sitting on one of them.
                            -->
                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="3"
                                    Content="Clean up" Padding="14,4"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding NotCleaningUp}"
                                    Command="{Binding CleanUpCommand}" />
                        </Grid>

                        <!-- Deleting gigabytes takes real time; without this the window
                             just stops, which reads as a hang rather than as work. -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsCleaningUp}">
                            <ProgressBar IsIndeterminate="True" Height="6" />
                            <TextBlock Text="{Binding CleanupStage}" FontSize="11" Opacity="0.75" />
                        </StackPanel>

                        <TextBlock Text="{Binding CleanupSummary}" FontSize="11" Opacity="0.75"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding CleanupSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Separator Margin="0,4" />

                        <TextBlock Text="Installed game versions" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>

                        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,8" CornerRadius="1"
                                IsVisible="{Binding Games.HasError}"
                                Background="{DynamicResource VsErrorFillBrush}" BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Games.Error}" TextWrapping="Wrap" FontSize="12" />
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                            <ProgressBar x:Name="GamesProgress"
                                         Maximum="1" Value="{Binding Games.ProgressFraction}"
                                         IsIndeterminate="{Binding Games.ProgressIndeterminate}"
                                         IsVisible="{Binding Games.IsBusy}" Height="6" />
                            <TextBlock Text="{Binding Games.Progress}" FontSize="12" Opacity="0.75" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,16,*">

                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Installed" FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding !Games.ConfirmingRemove}">
                                        <Button Content="Remove"
                                                Command="{Binding Games.RequestRemoveCommand}" />
                                        <Button Content="Install its .NET"
                                                Command="{Binding Games.InstallRuntimeCommand}" />
                                    </StackPanel>

                                    <!-- A version can be in use by a pack, so say what removing it costs. -->
                                    <Border IsVisible="{Binding Games.ConfirmingRemove}" Padding="10,8" CornerRadius="1"
                                            Background="{DynamicResource VsErrorFillBrush}"
                                            BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Games.RemoveConsequence}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Remove" Classes="accent" Padding="14,4"
                                                        Command="{Binding Games.RemoveSelectedCommand}" />
                                                <Button Content="Keep" Padding="14,4"
                                                        Command="{Binding Games.CancelRemoveCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="private .NET runtimes" FontSize="11" Opacity="0.6" />
                                    <ItemsControl ItemsSource="{Binding Games.ManagedRuntimes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="11" Opacity="0.7" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Games.Installed}"
                                         SelectedItem="{Binding Games.SelectedInstalled}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InstalledGameViewModel">
                                            <StackPanel Spacing="2" Margin="0,3">
                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Origin}" FontSize="11" Opacity="0.7"
                                                           IsVisible="{Binding !IsManaged}" />
                                                <TextBlock Text="{Binding Needs}" FontSize="11" Opacity="0.7" />
                                                <TextBlock Text="{Binding RuntimeLine}" FontSize="11"
                                                           Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="no matching .NET runtime — cannot start"
                                                           IsVisible="{Binding RuntimeMissing}"
                                                           FontSize="11" Foreground="{DynamicResource VsErrorBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <DockPanel Grid.Column="2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Available" FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <!-- Wraps rather than spills: these three together are wider than
                                     half the pane at the window's minimum width. -->
                                <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                           ItemSpacing="6" LineSpacing="6" Margin="0,6,0,0">
                                    <Button Content="Install" Classes="accent"
                                            Command="{Binding Games.InstallSelectedCommand}" />
                                    <Button Content="Refresh list"
                                            Command="{Binding Games.RefreshCatalogCommand}" />
                                    <CheckBox Content="pre-releases"
                                              IsChecked="{Binding Games.IncludePreReleases}" />
                                </WrapPanel>
                                <ListBox ItemsSource="{Binding Games.Available}"
                                         SelectedItem="{Binding Games.SelectedAvailable}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AvailableGameViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Version}"
                                                           FontWeight="SemiBold" Width="90" />
                                                <TextBlock Grid.Column="1" Text="{Binding Note}"
                                                           FontSize="11" Opacity="0.65"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Size}"
                                                           FontSize="11" Opacity="0.6"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
