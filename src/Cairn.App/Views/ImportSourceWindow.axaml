<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Cairn.App"
        xmlns:vm="using:Cairn.App.ViewModels"
        x:Class="Cairn.App.Views.ImportSourceWindow"
        x:DataType="vm:ImportSourceViewModel"
        Title="{l:Tr importsrc-title}"
        Width="620" MinWidth="480" MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VsWindowBrush}">

    <!--
        Same shape as the other dialogs: the long thing in the middle scrolls, and what
        commits it keeps its place at the bottom however long the list gets.

        The height follows the content rather than being fixed, because the three sources
        are not the same size. A link is one text box; an install is a list of forty mods.
        A window tall enough for the longest one left the short ones as a field, a button,
        and a lot of nothing — which reads as something failing to load. MaxHeight is what
        keeps a big install inside the screen: past it the list scrolls, which is what the
        scroll area was always for.
    -->
    <DockPanel Margin="16" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="{l:Tr importsrc-where}" FontSize="16" FontWeight="SemiBold" />

            <!-- Named rather than guessed from what gets typed. The first of the three is
                 the one most people want and the one that used not to exist. -->
            <RadioButton GroupName="Source" IsChecked="{Binding FromInstall}"
                         Content="{l:Tr importsrc-from-install}" FontSize="12" />
            <RadioButton GroupName="Source" IsChecked="{Binding FromLink}"
                         Content="{l:Tr importsrc-from-link}" FontSize="12" />
            <RadioButton GroupName="Source" IsChecked="{Binding FromPaste}"
                         Content="{l:Tr importsrc-from-text}" FontSize="12" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">

            <Border IsVisible="{Binding HasError}" Padding="10,8" CornerRadius="1"
                    Background="{DynamicResource VsErrorFillBrush}"
                    BorderBrush="{DynamicResource VsErrorBrush}" BorderThickness="1">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <!-- Naming the pack: only ever asked when making one from an install. A shared
                 pack arrives with a name, and is renamed on the dialog that shows it. -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                  IsVisible="{Binding FromInstall}">
                <TextBlock Grid.Column="0" Text="{l:Tr importsrc-call-it}" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" MinWidth="70" />
                <TextBox Grid.Column="1" Name="NameBox" Text="{Binding PackName}" />
                <TextBlock Grid.Column="2" Text="{Binding Slug}" FontSize="11" Opacity="0.6"
                           VerticalAlignment="Center" FontFamily="monospace" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  IsVisible="{Binding !FromInstall}">
                <TextBlock Grid.Column="0" Text="{l:Tr importsrc-import-as}" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center" MinWidth="70" />
                <TextBox Grid.Column="1" Name="IdBox" Text="{Binding AsId}"
                         PlaceholderText="{l:Tr importsrc-keep-name}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="ImportButton" Content="{Binding ImportLabel}" Classes="accent"
                        Padding="16,5" Click="OnImport" IsEnabled="{Binding CanImport}" />
                <Button Name="CancelButton" Content="{l:Tr common-cancel}" Padding="16,5"
                        Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <!-- One body per source, only one of them ever visible. -->
        <Panel>

            <!-- From the install -->
            <DockPanel IsVisible="{Binding FromInstall}" LastChildFill="True">
                <!--
                    No version to pick and no button to press: there is one folder, one game
                    version — the one those mods are being run on — and the list below is
                    the whole reason for choosing this source. It reads the folder as soon as
                    the dialog opens.
                -->
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8"
                               Text="{l:Tr importsrc-install-explain}" />

                    <!--
                        Where this reads from, as two labelled rows rather than a paragraph
                        and two loose paths.

                        It used to be a sentence about the version, a grey path, and then a
                        second grey path once the install became changeable — five lines of
                        prose above the list, with nothing saying which path was which. They
                        are two different folders that move independently: the game, and the
                        place it keeps your mods. A grid says so in two rows and leaves room
                        for the change each of them needs.

                        Both are asked for in the terms somebody can answer. "Mods" is the
                        folder the game's own instructions send people to; the data path it
                        implies is worked out from it — see InstalledMods.ChooseModsFolder —
                        because "data path" is a phrase nobody uses unless they have already
                        passed the game a dataPath argument.
                    -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto"
                          Margin="0,2,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr importsrc-row-game}"
                                   FontSize="12" Opacity="0.7" Margin="0,0,12,3"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Name="GameVersionText"
                                   Text="{Binding GameLine}"
                                   FontSize="12" Margin="0,0,12,3" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Name="InstallDirectoryText"
                                   Text="{Binding GameDetail}"
                                   FontSize="11" Opacity="0.55"
                                   VerticalAlignment="Center" Margin="0,0,12,3"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding InstallDirectory}" />

                        <Button Grid.Row="0" Grid.Column="3" Name="ChooseInstallButton"
                                Padding="10,2" FontSize="12" Margin="0,0,0,3"
                                Content="{l:Tr importsrc-change}"
                                Command="{Binding ChooseInstallCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr importsrc-row-mods}"
                                   FontSize="12" Opacity="0.7" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Name="ModsDirText"
                                   Text="{Binding ModsDir}"
                                   FontSize="11" Opacity="0.55" FontFamily="monospace"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ModsDir}" />

                        <Button Grid.Row="1" Grid.Column="3" Name="ChooseModsButton"
                                Padding="10,2" FontSize="12"
                                Content="{l:Tr importsrc-change}"
                                Command="{Binding ChooseModsCommand}" />
                    </Grid>

                    <!-- Prose only when something is wrong with what was picked. -->
                    <TextBlock Name="InstallProblemText" Text="{Binding InstallProblem}"
                               FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                               IsVisible="{Binding InstallProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock Name="ModsProblemText" Text="{Binding ModsProblem}"
                               FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                               IsVisible="{Binding ModsProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- The summary says what is in the folder as soon as it has been read,
                         and what can go in a pack once the lookups are done. The count
                         beside it only exists while they are running. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Progress}" FontSize="12" Opacity="0.6"
                                   IsVisible="{Binding Busy}" />
                    </StackPanel>
                </StackPanel>

                <!-- The worlds from the same install, all or none.

                     Under the mods rather than beside them: a world only opens against the
                     mod set it was made with, so the mods are the pack and these come with
                     them. Off by default, because a world is gigabytes and the pack works
                     without one — which is not true of the mods above.

                     One box rather than the list this used to be. Choosing between worlds is
                     a real thing to want and the pack's own Settings tab already does it,
                     with the pack in front of you; here the list was the tallest thing on a
                     screen about mods and grew with somebody's save folder. -->
                <CheckBox DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="12"
                          Name="BringWorldsCheck"
                          IsChecked="{Binding BringWorlds}"
                          IsVisible="{Binding HasWorlds}"
                          Content="{Binding WorldsLabel}" />

                <Panel>
                    <!-- Nothing to show yet. An empty bordered scroll area looks exactly
                         like a text box you are not allowed to type in, which is the last
                         thing to show somebody the moment a dialog opens. -->

                    <Border IsVisible="{Binding HasRows}"
                            BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1"
                            CornerRadius="1" Padding="2">
                        <ScrollViewer Name="ModList" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Mods}" Margin="8,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImportRowViewModel">
                                        <!-- The ones that will not make it are dimmed, not
                                             hidden: a count that does not add up is worse
                                             than a list with three greyed rows in it. -->
                                        <!-- Ticked, and read to untick.

                                             The list used to be Cairn's decision reported
                                             back: a mod it would not take was dimmed and
                                             there was nothing to press. But somebody who
                                             chose this source has already said "a pack of
                                             what I am running", and the mods it left out
                                             were the ones they knew best — running for
                                             months against a tag that had stopped being
                                             updated. So everything that can go in does, and
                                             the row is where it comes out.

                                             The ones that cannot keep the tick, disabled: a
                                             row with no control where every other row has
                                             one reads as an oversight, and the verdict
                                             beside it is the explanation. -->
                                        <Grid ColumnDefinitions="*,150" Margin="0,3"
                                              Opacity="{Binding RowOpacity}">
                                            <CheckBox Grid.Column="0" FontSize="12"
                                                      IsChecked="{Binding Include}"
                                                      IsEnabled="{Binding CanInclude}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Note}" FontSize="11"
                                                               Opacity="0.6" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>

                                            <TextBlock Grid.Column="1" Text="{Binding Verdict}"
                                                       FontSize="11" Opacity="0.75"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Panel>

            </DockPanel>

            <!-- From a link -->
            <StackPanel IsVisible="{Binding FromLink}" Spacing="8">
                <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8"
                           Text="{l:Tr importsrc-link-explain}" />
                <TextBox Name="UrlBox" Text="{Binding Url}"
                         PlaceholderText="{l:Tr importsrc-link-placeholder}" />
            </StackPanel>

            <!-- From pasted text or a file -->
            <DockPanel IsVisible="{Binding FromPaste}" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap" Opacity="0.8"
                           Margin="0,0,0,8"
                           Text="{l:Tr importsrc-text-explain}" />
                <!-- A pack is a few hundred lines of JSON. Room to see that something
                     arrived, and to scroll it; the window is no taller than it needs. -->
                <TextBox Name="PasteBox" Text="{Binding Text}" AcceptsReturn="True"
                         MinHeight="220" MaxHeight="360"
                         TextWrapping="NoWrap" FontFamily="monospace" FontSize="12"
                         PlaceholderText="{l:Tr importsrc-text-placeholder}" />
            </DockPanel>
        </Panel>
    </DockPanel>
</Window>
